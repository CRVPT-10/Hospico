{
  "name": "hospico-backend",
  "image": "docker.io/crvpt/hospico-backend:v28-cloudscale",
  "port": 8080,
  "environment": {},
  "healthCheck": {
    "path": "/actuator/health",
    "interval": 30,
    "timeout": 10,
    "unhealthyThreshold": 3
  },
  "resources": {
    "cpu": "1",
    "memory": "512Mi"
  },
  "scaling": {
    "minInstances": 1,
    "maxInstances": 3
  }
}
